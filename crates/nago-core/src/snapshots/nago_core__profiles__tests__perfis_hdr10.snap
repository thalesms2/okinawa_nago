---
source: crates/nago-core/src/profiles.rs
expression: "lines.join(\"\\n\")"
---
libsvtav1: -c:v libsvtav1 -pix_fmt yuv420p10le -crf 24 -preset 6 -g 300 -svtav1-params tune=0:mastering-display=G(0.2650,0.6900)B(0.1500,0.0600)R(0.6800,0.3200)WP(0.3127,0.3290)L(1000.0000,0.0050):content-light=1000,400 -vf setparams=color_primaries=bt2020:color_trc=smpte2084:colorspace=bt2020nc:range=tv
libx265: -c:v libx265 -pix_fmt yuv420p10le -crf 21 -preset slow -x265-params log-level=error:repeat-headers=1:hdr10=1:hdr10-opt=1:master-display=G(13250,34500)B(7500,3000)R(34000,16000)WP(15635,16450)L(10000000,50):max-cll=1000,400 -vf setparams=color_primaries=bt2020:color_trc=smpte2084:colorspace=bt2020nc:range=tv
av1_nvenc: -c:v av1_nvenc -pix_fmt p010le -preset p6 -tune hq -rc vbr -cq 32 -b 0 -multipass qres -spatial-aq 1 -temporal-aq 1 -rc-lookahead 32 -g 300 -vf setparams=color_primaries=bt2020:color_trc=smpte2084:colorspace=bt2020nc:range=tv
